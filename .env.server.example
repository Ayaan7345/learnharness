# ── Server mode (required) ─────────────────────────────────────────────
# Setting a password turns on sign-in for every page and API route.
LH_SERVER_PASSWORD=change-me-to-a-long-passphrase

# Signs session cookies. Generate with: openssl rand -hex 32
# If unset, sessions are signed with the password (changing it signs every device out).
LH_SESSION_SECRET=

# Optional bearer token (32+ chars) for scripts or a future native app:
#   curl -H "Authorization: Bearer $LH_API_TOKEN" https://your-host/api/chats
LH_API_TOKEN=

# Cookies get the Secure flag automatically behind an HTTPS proxy
# (X-Forwarded-Proto: https). Force with 1, disable with 0 (plain-HTTP LAN only).
# LH_COOKIE_SECURE=

# ── Provider keys (optional here) ──────────────────────────────────────
# You can also add keys in the app under Settings → Providers; they are
# stored in /data/auth.json on the server. Real env vars win over that file.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
